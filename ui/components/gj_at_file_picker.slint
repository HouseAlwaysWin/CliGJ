import { AppTheme } from "../theme.slint";

/// Ctrl+P workspace quick-open popup with a VS Code style searchable file list.
export component GjAtFilePicker inherits Rectangle {
    in property <bool> open: false;
    in property <string> terminal-font-family: "DejaVu Sans Mono";
    in property <string> root-label;
    in property <string> filter-text;
    in property <[string]> choices;
    in-out property <int> selected-index: 0;
    callback choose(int);

    private property <length> header-h: 28px * AppTheme.ui_zoom_factor;
    private property <length> row-h: 28px * AppTheme.ui_zoom_factor;
    private property <int> visible-rows-cap: 10;
    private property <length> empty-state-h: 72px * AppTheme.ui_zoom_factor;
    private property <length> input-pad-x: 10px * AppTheme.ui_zoom_factor;
    private property <length> input-pad-right: 12px * AppTheme.ui_zoom_factor;
    private property <length> caret-w: 2px * AppTheme.ui_zoom_factor;
    private property <length> caret-h: 18px * AppTheme.ui_zoom_factor;
    private property <length> list-view-h: choices.length == 0
        ? empty-state-h
        : min(row-h * visible-rows-cap, row-h * choices.length);

    visible: open;
    height: open
        ? min(
            460px * AppTheme.ui_zoom_factor,
            112px * AppTheme.ui_zoom_factor + list-view-h
        )
        : 0px;
    background: #11131a;
    border-width: 1px;
    border-color: AppTheme.prompt_chrome_border;
    border-radius: 12px * AppTheme.ui_zoom_factor;
    clip: true;

    VerticalLayout {
        padding: 10px * AppTheme.ui_zoom_factor;
        spacing: 8px * AppTheme.ui_zoom_factor;

        HorizontalLayout {
            height: root.header-h;
            spacing: 8px * AppTheme.ui_zoom_factor;

            Text {
                text: "Quick Open";
                color: AppTheme.text;
                font-size: 13px * AppTheme.ui_zoom_factor;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #00000000;
            }

            Text {
                text: "Ctrl+P";
                color: AppTheme.text_muted;
                font-size: 11px * AppTheme.ui_zoom_factor;
                vertical-alignment: center;
            }
        }

        input-chrome := Rectangle {
            horizontal-stretch: 1;
            min-height: 36px * AppTheme.ui_zoom_factor;
            border-radius: 8px * AppTheme.ui_zoom_factor;
            background: input-hit.has-hover ? #0d1118 : AppTheme.bg;
            border-width: 1px;
            border-color: input-hit.has-hover
                ? AppTheme.prompt_submit_bg_hover
                : AppTheme.prompt_submit_bg;

            input-value := Text {
                x: root.input-pad-x + (filter-text == "" ? 8px * AppTheme.ui_zoom_factor : 0px);
                width: parent.width - root.input-pad-x - root.input-pad-right;
                height: parent.height;
                text: filter-text == "" ? "Type to search files" : filter-text;
                color: filter-text == "" ? AppTheme.text_muted : AppTheme.text;
                font-size: 13px * AppTheme.ui_zoom_factor;
                font-family: root.terminal-font-family;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                visible: root.open;
                x: filter-text == ""
                    ? root.input-pad-x
                    : min(
                        input-chrome.width - root.input-pad-right - root.caret-w,
                        input-value.x + input-value.preferred-width + 1px * AppTheme.ui_zoom_factor
                    );
                y: (parent.height - root.caret-h) / 2;
                width: root.caret-w;
                height: root.caret-h;
                border-radius: 1px * AppTheme.ui_zoom_factor;
                background: AppTheme.text;
            }

            input-hit := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => {}
            }
        }

        if (root-label != ""): Text {
            text: root-label;
            font-size: 10px * AppTheme.ui_zoom_factor;
            color: AppTheme.text_muted;
            wrap: word-wrap;
        }

        Rectangle {
            height: root.list-view-h;
            border-radius: 8px * AppTheme.ui_zoom_factor;
            background: #0d1017;
            border-width: 1px;
            border-color: AppTheme.prompt_chrome_border;
            clip: true;

            if choices.length == 0: VerticalLayout {
                padding: 0px;
                spacing: 4px * AppTheme.ui_zoom_factor;
                alignment: center;

                Text {
                    text: "No matching files";
                    color: AppTheme.text;
                    font-size: 12px * AppTheme.ui_zoom_factor;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Keep typing, Backspace, or press Esc";
                    color: AppTheme.text_muted;
                    font-size: 10px * AppTheme.ui_zoom_factor;
                    horizontal-alignment: center;
                }
            }

            at-flick := Flickable {
                visible: choices.length > 0;
                width: parent.width;
                height: root.list-view-h;
                viewport-width: parent.width;
                viewport-height: inner.preferred-height;

                inner := VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    for path[idx] in choices: Rectangle {
                        background: idx == selected-index
                            ? AppTheme.picker_row_selected
                            : (row-ta.has-hover ? #181c25 : #00000000);
                        height: root.row-h;

                        row-ta := TouchArea {
                            clicked => {
                                root.selected-index = idx;
                                root.choose(idx);
                            }

                            Text {
                                x: 10px * AppTheme.ui_zoom_factor;
                                width: parent.width - 20px * AppTheme.ui_zoom_factor;
                                height: parent.height;
                                text: path;
                                color: AppTheme.text;
                                font-size: 12px * AppTheme.ui_zoom_factor;
                                font-family: root.terminal-font-family;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }

    /// Call after `selected-index` changes (e.g. keyboard) so the row stays in view.
    public function ensure_selection_visible() {
        if choices.length <= 0 {
            return;
        }
        let vis = at-flick.height;
        let ch = at-flick.viewport-height;
        if ch <= vis {
            at-flick.viewport-y = 0px;
            return;
        }
        let sel-top = selected-index * row-h;
        let max-doc = ch - vis;
        let doc-top = min(sel-top, max-doc);
        at-flick.viewport-y = 0px - doc-top;
    }
}
